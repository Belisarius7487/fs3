@Laser Glow:	Alouqua_Glow
@Laser Color:	255, 0, 0
@Laser Color2:	128, 0, 128
@Laser Length:	3.0
@Laser Head Radius:	1.9
@Laser Tail Radius:	1.9
$Flags: ( "detonate on expiration" )
$Trail:
	+Start Width:	0.35
	+End Width:		0.1
	+Start Alpha:	0.4
	+End Alpha:		0.0
	+Max Life:		0.07
	+Bitmap:		Alouqua_Trail
$Impact Explosion:	Shivan_Impact01
$Impact Explosion Radius: 2.5
$Muzzleflash: 	Rmuzzle

