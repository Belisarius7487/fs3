)
$Multi text
    XSTR("The destruction of the GTM Vesalius is a tragedy. With the casualties the Shivans have inflicted in Capella, every medical vessel is vital to our efforts.", 1767)
$end_multi_text
$Voice: SM306_DB_08.wav
$Recommendation text:
    XSTR("", 10)
$end_multi_text

$Formula: ( and 
   ( is-event-true-delay "Jump okay" 0 ) 
