)
$Multi text
    XSTR("The GTM Vesalius arrived in Epsilon Pegasi. The medical vessel will play a crucial role in handling the influx of refugees from Capella.", 1768)
$end_multi_text
$Voice: SM306_DB_09.wav
$Recommendation text:
