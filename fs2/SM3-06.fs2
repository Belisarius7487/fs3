   )
)
$Multi text
    XSTR("The Shivans launched a massive offensive against all our outbound convoys. The death toll has escalated into the hundred of thousands. We do not have the resources to defend every ship escaping this system. Even your elite 70th Blue Lions failed to complete all mission objectives.", 1761)
$end_multi_text
$Voice: sm306_db_02.wav
$Recommendation text:
    XSTR("", 10)
$end_multi_text

$Formula: ( and 
