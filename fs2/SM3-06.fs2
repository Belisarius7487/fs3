$end_stage
$start_stage
$multi_text
 XSTR("Blue Lions, your mission is to escort a four-ship convoy to Epsilon Pegasi. The group consists of civilian transports $f Lambda $f 1 and $f 2, $f GTFr $f Sulla, and the medical ship $f GTM $f Vesalius. All have minimal armaments and vulnerable hull plating. $f GVCv $f Nebtuu leads the escort.", 1757)
$end_multi_text
